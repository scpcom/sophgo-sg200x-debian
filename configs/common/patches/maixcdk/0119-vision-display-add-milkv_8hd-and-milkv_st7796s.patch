@@ -72,6 +72,13 @@ namespace maix::display
         } else if (!strcmp(panel_value, "zct2133v1")) {
             w = 800;
             h = 1280;
+        } else if (!strcmp(panel_value, "milkv_8hd") ||
+                   !strcmp(panel_value, "milkv_8hd_2lane")) {
