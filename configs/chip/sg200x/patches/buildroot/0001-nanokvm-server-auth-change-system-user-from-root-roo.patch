+diff --git a/server/service/auth/password.go b/server/service/auth/password.go
+index 22c6016..a40ed2a 100644
+--- a/server/service/auth/password.go
++++ b/server/service/auth/password.go
+@@ -40,7 +40,7 @@ func (s *Service) ChangePassword(c *gin.Context) {
+ 		return
+ 	}
+ 
+-	// change root password
++	// change debian password
+ 	err = changeRootPassword(password)
+ 	if err != nil {
+ 		_ = DelAccount()
+@@ -80,16 +80,16 @@ func (s *Service) IsPasswordUpdated(c *gin.Context) {
+ func changeRootPassword(password string) error {
+ 	err := passwd(password)
+ 	if err != nil {
+-		log.Errorf("failed to change root password: %s", err)
++		log.Errorf("failed to change debian password: %s", err)
+ 		return err
+ 	}
+ 
+-	log.Debugf("change root password successful.")
++	log.Debugf("change debian password successful.")
+ 	return nil
+ }
+ 
+ func passwd(password string) error {
+-	cmd := exec.Command("passwd", "root")
++	cmd := exec.Command("passwd", "debian")
+ 
+ 	stdin, err := cmd.StdinPipe()
+ 	if err != nil {
+diff --git a/support/sg2002/kvm_system/main/lib/system_ctrl/system_ctrl.cpp b/support/sg2002/kvm_system/main/lib/system_ctrl/system_ctrl.cpp
